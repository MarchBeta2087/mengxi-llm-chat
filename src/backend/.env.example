# 梦溪畅谈后端环境变量（复制为 .env 使用）
# 变量前缀统一为 MENGXI_

# --- 基础 ---
MENGXI_ENVIRONMENT=development
MENGXI_DEBUG=false
MENGXI_DATA_DIR=./data

# --- 主密钥 KEK（档位 A/B/C，见设计说明书 §3.3）---
# A: 口令派生（每次重启需解锁），B: 环境变量主密钥，C: 外部 KMS
MENGXI_KEK_PROFILE=A
# 仅档 B 需要：32 字节主密钥的 base64（生成：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
# MENGXI_MASTER_KEY_B64=

# Argon2id 参数（档 A）
MENGXI_ARGON2_TIME_COST=3
MENGXI_ARGON2_MEMORY_COST=65536
MENGXI_ARGON2_PARALLELISM=4
MENGXI_ARGON2_HASH_LEN=32

# 主口令错误锁定
MENGXI_KEK_LOCK_THRESHOLD=5
MENGXI_KEK_LOCK_SECONDS=900

# --- SSRF（设计说明书 §4.4）---
MENGXI_ALLOW_HTTP_UPSTREAM=false
MENGXI_DOMAIN_WHITELIST=
MENGXI_MAX_REDIRECTS=5

# --- 存储 ---
MENGXI_DATABASE_URL=postgresql+asyncpg://mengxi:mengxi@localhost:5432/mengxi
MENGXI_REDIS_URL=redis://localhost:6379/0

# --- 策略 ---
MENGXI_FALLBACK_TO_PUBLIC=true
MENGXI_AUDIT_RETENTION_DAYS=90

# 内置插件目录（管理后台“插件市场”一键安装；留空=禁用）
MENGXI_BUILTIN_PLUGINS_DIR=

# --- 三层兜底限流（JSON，空=关闭）---
MENGXI_USER_RATE_LIMITS=
MENGXI_IP_RATE_LIMITS=
